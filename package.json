{
	"name": "twinkle-thwiki",
	"version": "1.0.0",
	"description": "",
	"scripts": {
		"format": "prettier --write .",
		"lint": "eslint . --ext .js --ext .ts",
		"lint:fix": "eslint . --ext .js --ext .ts --fix",
		"build": "grunt build",
		"quickbuild": "webpack",
		"start": "node scripts/server.js",
		"test:prod": "webpack && jest",
		"test": "env DEBUG=true webpack && jest -i",
		"test:unit": "webpack && jest --selectProjects unit",
		"test:integration": "webpack && jest --selectProjects integration",
		"test:integration:setup": "npm i --no-save playwright@1.9.1 && cd tests/integration/docker && bash main.sh",
		"test:integration:teardown": "cd tests/integration/docker && docker-compose down"
	},
	"repository": {
		"type": "git",
		"url": "git://github.com/ptsgrn/twinkle-thwiki.git"
	},
	"author": "ptsgrn",
	"license": "CC-BY-SA-3.0",
	"homepage": "https://github.com/ptsgrn/twinkle-thwiki",
	"sideEffects": [
		"src/globals.ts"
	],
	"dependencies": {
		"orange-i18n": "^4.0.3",
		"terser-webpack-plugin": "^5.6.1",
		"tslib": "2.8.1",
		"twinkle-core": "^3.1.3"
	},
	"devDependencies": {
		"@babel/core": "^7.29.7",
		"@babel/preset-env": "^7.29.7",
		"@types/chai": "^4.3.20",
		"@types/chai-as-promised": "^7.1.8",
		"@types/jest": "^26.0.24",
		"@typescript-eslint/eslint-plugin": "^4.33.0",
		"@typescript-eslint/parser": "^4.33.0",
		"babel-loader": "^9.2.1",
		"chai": "^4.5.0",
		"chai-as-promised": "^7.1.2",
		"chalk": "^4.1.2",
		"diff": "^5.2.2",
		"eslint": "^7.32.0",
		"grunt": "1.6.1",
		"grunt-contrib-clean": "^2.0.1",
		"grunt-contrib-concat": "^2.1.0",
		"grunt-contrib-copy": "^1.0.0",
		"grunt-replace": "^2.0.2",
		"grunt-webpack": "^6.0.0",
		"husky": "^4.3.8",
		"jest": "^26.6.3",
		"jest-playwright-preset": "^1.7.2",
		"lint-staged": "^10.5.4",
		"minimist": "1.2.8",
		"mock-mediawiki": "^1.5.1",
		"mwn": "^0.10.4",
		"prettier": "^3.9.6",
		"prompts": "^2.4.2",
		"ts-jest": "^26.5.6",
		"ts-loader": "8.0.13",
		"typescript": "4.1.2",
		"webpack": "5.110.1",
		"webpack-cli": "^5.1.4",
		"webpack-dev-server": "^5.2.6"
	},
	"husky": {
		"hooks": {
			"pre-commit": "lint-staged"
		}
	},
	"lint-staged": {
		"*.ts(x)?": "prettier --write"
	},
	"trustedDependencies": [
		"husky",
		"playwright-core"
	]
}
